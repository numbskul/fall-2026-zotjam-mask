[sub_resource type="Resource" id="7lsnw"]
script = ExtResource("2_48vp3")
item_type = 1
connected_to_id = 1
condition_type = 4
condition_values = ["mouth_color", "3"]

[sub_resource type="Resource" id="6twqy"]
script = ExtResource("2_48vp3")
message_speaker_id = "MV"
message_text = "Oh dear, an old woman like me in a job like this, they’d never know a thing, haha!"

[sub_resource type="Resource" id="Resource_kur6e"]
script = ExtResource("2_48vp3")
message_speaker_id = "MV"
message_text = "The other investors thought it was crazy and said I was “blowing myself up” and getting too big for my britches."

[sub_resource type="Resource" id="Resource_gi4cx"]
script = ExtResource("2_48vp3")
message_speaker_id = "MV"
message_text = " But you know, I’m the second oldest person in the room, my luck is [b]TWO[/b]fold!"

[sub_resource type="Resource" id="57kek"]
script = ExtResource("4_f2ijm")
position = Vector2(-600, -320)
items = [SubResource("f0gcp"), SubResource("7lsnw"), SubResource("6twqy"), SubResource("Resource_kur6e"), SubResource("Resource_gi4cx")]
continue_port_index = 2

[sub_resource type="Resource" id="s11vk"]
script = ExtResource("2_48vp3")
message_speaker_id = "MV"
message_text = "Oh dear, oh dear. I hope my friends weren’t rude to you."

[sub_resource type="Resource" id="Resource_mjnvi"]
script = ExtResource("2_48vp3")
message_speaker_id = "MV"
message_text = " They don’t see non investors as important sometimes, that time travel business has got them loony."

[sub_resource type="Resource" id="Resource_ig706"]
script = ExtResource("2_48vp3")
message_speaker_id = "MV"
message_text = "Well, I’ll let you get back to the party."

[sub_resource type="Resource" id="ty1re"]
script = ExtResource("4_f2ijm")
sequence_id = 1
position = Vector2(-180, -300)
items = [SubResource("s11vk"), SubResource("Resource_mjnvi"), SubResource("Resource_ig706")]
