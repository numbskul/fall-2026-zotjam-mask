[sub_resource type="Resource" id="Resource_fl4st"]
script = ExtResource("2_48vp3")
message_speaker_id = "AA"
message_text = "Hello there, do you have any business with me?"

[sub_resource type="Resource" id="ronjm"]
script = ExtResource("2_48vp3")
message_speaker_id = "AA"
message_text = "I’m trying to keep watch on the prices, so if you have any commonplace inquiries, please direct them to someone more.."

[sub_resource type="Resource" id="scbln"]
script = ExtResource("2_48vp3")
message_speaker_id = "AA"
message_text = "... at your level?"

