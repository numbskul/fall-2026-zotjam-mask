[sub_resource type="Resource" id="86kbs"]
script = ExtResource("2_48vp3")
message_speaker_id = "MC"
message_text = "You must try this first delight! It is quite, as we would say, the “BOMB!”"

[sub_resource type="Resource" id="iyv7e"]
script = ExtResource("2_48vp3")
message_speaker_id = "MC"
message_text = "Ahaha! It tastes so delicate, so delicious, that it feels like the NINE realms are expanding!"

[sub_resource type="Resource" id="dsmgf"]
script = ExtResource("2_48vp3")
message_speaker_id = "MC"
message_text = "What a heavenly experience."

[sub_resource type="Resource" id="6d3fn"]
