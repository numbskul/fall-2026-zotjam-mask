[sub_resource type="Resource" id="gvup7"]
script = ExtResource("2_48vp3")
message_speaker_id = "DF"
message_text = "To tell you the truth, I look like a partygoer, but I’m really a culinary aficionado."

[sub_resource type="Resource" id="Resource_1rg48"]
script = ExtResource("2_48vp3")
message_speaker_id = "DF"
message_text = "Ferguson hates me, but he’s just a buzzkill yo."

[sub_resource type="Resource" id="Resource_4qw0o"]
script = ExtResource("2_48vp3")
message_speaker_id = "DF"
message_text = "I got the title of aficionado from eating 4 whole cakes in 5 minutes during high school, heh."

[sub_resource type="Resource" id="udfvu"]
script = ExtResource("4_f2ijm")
position = Vector2(-560, -60)
items = [SubResource("1rg48"), SubResource("4qw0o"), SubResource("gvup7"), SubResource("Resource_1rg48"), SubResource("Resource_4qw0o")]
continue_port_index = 2

[sub_resource type="Resource" id="x2ldl"]
script = ExtResource("2_48vp3")
message_speaker_id = "DF"
message_text = "Sup, broski.  I just took a NASTY swig of this punch, and it isn’t calming me down!"

[sub_resource type="Resource" id="bkkvj"]
script = ExtResource("2_48vp3")
message_speaker_id = "DF"
message_text = " I don’t even wanna talk to you, you look like you’re just gonna hic ruin my funk, you know?"

[sub_resource type="Resource" id="j4aaj"]
script = ExtResource("2_48vp3")
message_speaker_id = "DF"
message_text = " Now buzz off, I need another drink."

[sub_resource type="Resource" id="uno3w"]
