condition_values = ["emblem_color", "2"]

[sub_resource type="Resource" id="Resource_iyv7e"]
script = ExtResource("2_48vp3")
message_speaker_id = "JF"
message_text = "I can see past your front, friend."

[sub_resource type="Resource" id="Resource_dsmgf"]
script = ExtResource("2_48vp3")
message_speaker_id = "JF"
message_text = "You’re no simple partygoer, but you’re no nobility, are you? No no no, you’re something more special."

[sub_resource type="Resource" id="Resource_fwb2u"]
script = ExtResource("2_48vp3")
message_speaker_id = "JF"
message_text = "An exception."

[sub_resource type="Resource" id="Resource_1yy6g"]
script = ExtResource("2_48vp3")
message_speaker_id = "JF"
message_text = "How did I know? I can smell you. Don’t worry, I won’t go tattling."

[sub_resource type="Resource" id="Resource_ghijk"]
script = ExtResource("2_48vp3")
message_speaker_id = "JF"
message_text = "To tell you the truth, I’m no simple partygoer either. We are both the exceptions, aren’t we?"

[sub_resource type="Resource" id="Resource_t2a6b"]
script = ExtResource("2_48vp3")
message_speaker_id = "JF"
message_text = " Playing our false roles just so long as it suits us."

[sub_resource type="Resource" id="Resource_lge7f"]
script = ExtResource("4_f2ijm")
position = Vector2(-560, -240)
items = [SubResource("d0tsa"), SubResource("s0amn"), SubResource("Resource_iyv7e"), SubResource("Resource_dsmgf"), SubResource("Resource_fwb2u"), SubResource("Resource_1yy6g"), SubResource("Resource_ghijk"), SubResource("Resource_t2a6b")]
continue_port_index = 2

[sub_resource type="Resource" id="Resource_1e8bj"]
script = ExtResource("2_48vp3")
message_speaker_id = "JF"
message_text = "Quite the elitists aren’t they, those investors and artisans. I’d love to rip into them..have a little taste of their bones…"

[sub_resource type="Resource" id="Resource_ronjm"]
script = ExtResource("2_48vp3")
message_speaker_id = "JF"
message_text = "Argh, pay me no mind. I should keep my mouth shut lest you be one of their ilk.. "

[sub_resource type="Resource" id="Resource_scbln"]
script = ExtResource("2_48vp3")
message_speaker_id = "JF"
message_text = "If you’re truly one of us..well, I’ll figure it out in due time."

[sub_resource type="Resource" id="Resource_6da8k"]
script = ExtResource("4_f2ijm")
sequence_id = 1
position = Vector2(-160, -220)
items = [SubResource("Resource_1e8bj"), SubResource("Resource_ronjm"), SubResource("Resource_scbln")]
