condition_values = ["emblem_color", "2"]

[sub_resource type="Resource" id="grl7v"]
script = ExtResource("2_48vp3")
message_speaker_id = "HC"
message_text = "Now, I’ve looked around this room for the third time, checking out who’s who."

[sub_resource type="Resource" id="Resource_uj1nl"]
script = ExtResource("2_48vp3")
message_speaker_id = "HC"
message_text = " And between you and me mate, I only think about [b]SIX[/b] of em are trustworthy."

[sub_resource type="Resource" id="Resource_6d3fn"]
script = ExtResource("2_48vp3")
message_speaker_id = "HC"
message_text = "The other three? Well, who gives a rat’s tushie?"

[sub_resource type="Resource" id="Resource_86kbs"]
script = ExtResource("2_48vp3")
message_speaker_id = "HC"
message_text = "They can all[b] blow[/b] for all I care."

[sub_resource type="Resource" id="xyc8a"]
script = ExtResource("4_f2ijm")
position = Vector2(-480, -280)
items = [SubResource("s4tyb"), SubResource("c3itg"), SubResource("grl7v"), SubResource("Resource_uj1nl"), SubResource("Resource_6d3fn"), SubResource("Resource_86kbs")]
continue_port_index = 2

[sub_resource type="Resource" id="kvri2"]
script = ExtResource("2_48vp3")
message_speaker_id = "HC"
message_text = "Smashin’ party innit? Ya know, you don’t look too snazzy, I reckon you’re a partygoer yourself?
"

[sub_resource type="Resource" id="Resource_x2ldl"]
script = ExtResource("2_48vp3")
message_speaker_id = "HC"
message_text = " Eh, nah, ya look too fancy, but I guess anything’s possible."

[sub_resource type="Resource" id="Resource_m2qb1"]
script = ExtResource("2_48vp3")
message_speaker_id = "HC"
message_text = "Blasted Donald Tuff’s dressed like he’s about to go surfing and he’s s’posed to be a culinary aficionado..."

[sub_resource type="Resource" id="Resource_ogynd"]
script = ExtResource("2_48vp3")
message_speaker_id = "HC"
message_text = "Weirdos."

[sub_resource type="Resource" id="ukai7"]
