[sub_resource type="Resource" id="ogynd"]
script = ExtResource("2_48vp3")
message_speaker_id = "MC"
message_text = "Ohoho! You are simply a partygoer, yes? "

[sub_resource type="Resource" id="fwb2u"]
script = ExtResource("2_48vp3")
message_speaker_id = "MC"
message_text = "Can you use your inferior tastebuds to try this dish?"

[sub_resource type="Resource" id="1yy6g"]
script = ExtResource("2_48vp3")
message_speaker_id = "MC"
message_text = " I do not want to get my tongue, eh, dirtied if this is not well made."

[sub_resource type="Resource" id="ghijk"]
script = ExtResource("2_48vp3")
message_speaker_id = "MC"
message_text = "No? Do not waste my time."

