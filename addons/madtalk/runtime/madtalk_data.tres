[sub_resource type="Resource" id="Resource_uslxw"]
script = ExtResource("2_48vp3")
message_speaker_id = "KS"
message_text = "Woah! Your face looks awesome!"

[sub_resource type="Resource" id="Resource_j4aaj"]
script = ExtResource("2_48vp3")
message_speaker_id = "KS"
message_text = "  I mean, its really pretty generic man! But at least you got some of the designs to match ours!"

[sub_resource type="Resource" id="Resource_xyc8a"]
script = ExtResource("2_48vp3")
message_speaker_id = "KS"
message_text = " I knew you weren’t one of those richy richies. Hey, have you seen Henry Callinger?"

[sub_resource type="Resource" id="Resource_grl7v"]
script = ExtResource("2_48vp3")
message_speaker_id = "KS"
message_text = " He’s pretty cool. He’s got nice moves!"

[sub_resource type="Resource" id="Resource_ukai7"]
script = ExtResource("4_f2ijm")
position = Vector2(-620, -300)
items = [SubResource("tbm1p"), SubResource("45srj"), SubResource("Resource_uslxw"), SubResource("Resource_j4aaj"), SubResource("Resource_xyc8a"), SubResource("Resource_grl7v")]
continue_port_index = 2

[sub_resource type="Resource" id="Resource_kvri2"]
script = ExtResource("2_48vp3")
message_speaker_id = "KS"
message_text = "[b]OMG, HAIII![/b] "

[sub_resource type="Resource" id="Resource_cc61g"]
script = ExtResource("2_48vp3")
message_speaker_id = "KS"
message_text = "Ew, you’re not one of those rich hoity toity kids are ya? Your style is so lame."

[sub_resource type="Resource" id="Resource_udfvu"]
script = ExtResource("2_48vp3")
message_speaker_id = "KS"
message_text = "Come back when you have some actual flair."

[sub_resource type="Resource" id="Resource_qcrkj"]
