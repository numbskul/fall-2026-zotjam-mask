[sub_resource type="Resource" id="6yf53"]
script = ExtResource("2_48vp3")
message_speaker_id = "AA"
message_text = "Why, I’m glad you’re here friend! These prices are insane!"

[sub_resource type="Resource" id="t2a6b"]
script = ExtResource("2_48vp3")
message_speaker_id = "AA"
message_text = " Quite the steal for such an extraordinary ability, is it not?"

[sub_resource type="Resource" id="lge7f"]
script = ExtResource("2_48vp3")
message_speaker_id = "AA"
message_text = " I watched “Back to the Future” and always dreamed of doing what they did!"

[sub_resource type="Resource" id="1e8bj"]
script = ExtResource("2_48vp3")
message_speaker_id = "AA"
message_text = "Do you think I'll be able to do it for real?"

[sub_resource type="Resource" id="kur6e"]
script = ExtResource("4_f2ijm")
