[sub_resource type="Resource" id="ig706"]
script = ExtResource("2_48vp3")
message_speaker_id = "GS"
message_text = "Oh! Joyous day it is! You know the prize, don’t you!?"

[sub_resource type="Resource" id="6da8k"]
script = ExtResource("2_48vp3")
message_speaker_id = "GS"
message_text = "Time. Travel. Ahaha!"

[sub_resource type="Resource" id="0401h"]
script = ExtResource("2_48vp3")
message_speaker_id = "GS"
message_text = "The Temporistic Foundation really does create marvels!"

[sub_resource type="Resource" id="cop6a"]
script = ExtResource("2_48vp3")
message_speaker_id = "GS"
message_text = " I’ll have a vacation in Hawaii, Bali, and Rome all in a day! Heh heh heh!"

[sub_resource type="Resource" id="iioy7"]
script = ExtResource("2_48vp3")
message_speaker_id = "GS"
message_text = "What’s up with that old fart in our posse, tho?"

[sub_resource type="Resource" id="0mplr"]
script = ExtResource("4_f2ijm")
position = Vector2(-480, -460)
items = [SubResource("tiiv5"), SubResource("uakif"), SubResource("ig706"), SubResource("6da8k"), SubResource("0401h"), SubResource("cop6a"), SubResource("iioy7")]
continue_port_index = 2

[sub_resource type="Resource" id="uwwod"]
script = ExtResource("2_48vp3")
message_speaker_id = "GS"
message_text = "I’ll have to contact the company; it seems like I may have enough funds to win! "

[sub_resource type="Resource" id="ji0hg"]
script = ExtResource("2_48vp3")
message_speaker_id = "GS"
message_text = "Wait, why am I sharing this with a [i]commoner[/i]?
"

[sub_resource type="Resource" id="xc0yo"]
script = ExtResource("2_48vp3")
message_speaker_id = "GS"
message_text = " Go back to your “partying” and save the real work for us!"

[sub_resource type="Resource" id="hkg3h"]
script = ExtResource("4_f2ijm")
sequence_id = 1
