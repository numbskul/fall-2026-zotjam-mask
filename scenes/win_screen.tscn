[sub_resource type="GDScript" id="GDScript_wv5lq"]
script/source = "extends Control

@onready var node: Node = $Node

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	node.start_dialog(\"win_capture\")

func _on_timer_timeout() -> void:
	node.dialog_acknowledge()

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"restart\"):
		node.abort_dialogue()
		node.start_dialogue(\"win_escape\")

func _on_node_dialog_finished(sheet_name: Variant, sequence_id: Variant) -> void:
	get_tree().change_scene_to_file(\"res://scenes/main_menu.tscn\")
"

